<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>المركز الهندي | كهربائي سيارات متنقل</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0b0d10;color:#fff}
.hero{padding:55px 22px;text-align:center;background:linear-gradient(145deg,#111820,#090a0c)}
.badge{display:inline-block;padding:8px 14px;border:1px solid #444;border-radius:30px;color:#ddd;margin-bottom:18px}
h1{font-size:38px;margin:8px 0 14px}h2{font-size:28px}p{color:#c9cdd2;line-height:1.8}
.btn{display:inline-block;text-decoration:none;padding:14px 22px;border-radius:12px;margin:7px;font-weight:bold}
.call{background:#fff;color:#111}.wa{background:#1faa59;color:#fff}
.wrap{max-width:950px;margin:auto;padding:28px 20px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}
.card{background:#15191e;border:1px solid #292e35;border-radius:16px;padding:22px}
.card h3{margin-top:0}.icon{font-size:30px}
.location{background:#12161a;border-radius:18px;padding:24px;margin-top:18px}
footer{text-align:center;padding:30px;color:#888}
@media(max-width:600px){h1{font-size:30px}}

.gallery{margin-top:34px}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.photo{position:relative;overflow:hidden;border-radius:18px;border:1px solid #292e35;background:#101419;min-height:210px}
.photo svg{display:block;width:100%;height:210px}
.photo span{position:absolute;right:12px;bottom:12px;background:rgba(0,0,0,.65);padding:7px 11px;border-radius:10px;font-weight:bold}
@media(max-width:700px){.gallery-grid{grid-template-columns:1fr}.photo,.photo svg{min-height:190px;height:190px}}
</style>
</head>
<body>
<section class="hero">
  <div class="badge">⚡ المركز الهندي | خدمة متنقلة + مركز صيانة</div>
  <h1>المركز الهندي<br>كهربائي سيارات متنقل</h1>
  <p>فحص أعطال وكهرباء السيارات وخدمة ميدانية عند موقعك، مع مركز في ماركا الشمالية.</p>
  <a class="btn call" href="tel:0781735039">📞 اتصل الآن</a>
  <a class="btn wa" href="https://wa.me/962781735039">💬 واتساب</a>
</section>

<main class="wrap">
  <h2>خدماتنا</h2>
  <div class="cards">
    <div class="card"><div class="icon">🔧</div><h3>فحص الأعطال</h3><p>تشخيص أعطال كهرباء السيارة وتحديد سبب المشكلة.</p></div>
    <div class="card"><div class="icon">⚡</div><h3>كهرباء سيارات</h3><p>فحص وإصلاح الدوائر والأسلاك والحساسات والمشاكل الكهربائية.</p></div>
    <div class="card"><div class="icon">🚗</div><h3>خدمة متنقلة</h3><p>بنوصلك على موقع السيارة للمساعدة والفحص حسب الحالة.</p></div>
    <div class="card"><div class="icon">🧰</div><h3>صيانة وفحص</h3><p>خدمة من خلال مركزنا في ماركا الشمالية.</p></div>
    <div class="card"><div class="icon">🔓</div><h3>فتح السيارة المقفلة</h3><p>فتح السيارة بعد التأكد من إثبات الملكية.</p></div>
    <div class="card"><div class="icon">🛞</div><h3>خدمة بناشر</h3><p>مساعدة في حالات البنشر وخدمة الطريق حسب الحالة.</p></div>
    <div class="card"><div class="icon">💻</div><h3>فحص كمبيوتر</h3><p>فحص إلكتروني للأعطال وقراءة رموز المشاكل.</p></div>
  </div>

  
<section class="gallery">
  <h2>من خدمات المركز</h2>
  <div class="gallery-grid">
    <div class="photo">
      <svg viewBox="0 0 600 360" xmlns="http://www.w3.org/2000/svg" aria-label="سيارة في ورشة كهرباء">
        <defs><linearGradient id="g1" x1="0" x2="1"><stop stop-color="#202830"/><stop offset="1" stop-color="#090b0e"/></linearGradient></defs>
        <rect width="600" height="360" fill="url(#g1)"/>
        <circle cx="470" cy="70" r="48" fill="#ffd34d" opacity=".8"/>
        <path d="M80 260 L130 190 Q150 165 190 160 L365 160 Q405 165 435 195 L490 260 Z" fill="#bfc6cc"/>
        <rect x="175" y="175" width="90" height="55" rx="8" fill="#263746"/>
        <rect x="280" y="175" width="90" height="55" rx="8" fill="#263746"/>
        <circle cx="170" cy="265" r="34" fill="#101214"/><circle cx="170" cy="265" r="15" fill="#8d969d"/>
        <circle cx="415" cy="265" r="34" fill="#101214"/><circle cx="415" cy="265" r="15" fill="#8d969d"/>
        <path d="M100 295 H500" stroke="#555" stroke-width="6"/>
      </svg><span>كهرباء سيارات</span>
    </div>
    <div class="photo">
      <svg viewBox="0 0 600 360" xmlns="http://www.w3.org/2000/svg" aria-label="فحص كمبيوتر السيارة">
        <rect width="600" height="360" fill="#0d1116"/>
        <rect x="95" y="55" width="410" height="245" rx="18" fill="#222a31" stroke="#555" stroke-width="5"/>
        <rect x="125" y="85" width="350" height="175" rx="8" fill="#0b151b"/>
        <path d="M150 215 L205 170 L255 195 L320 125 L370 155 L435 110" fill="none" stroke="#7ee787" stroke-width="8"/>
        <circle cx="205" cy="170" r="7" fill="#fff"/><circle cx="320" cy="125" r="7" fill="#fff"/>
        <rect x="240" y="300" width="120" height="16" rx="8" fill="#777"/>
      </svg><span>فحص كمبيوتر</span>
    </div>
    <div class="photo">
      <svg viewBox="0 0 600 360" xmlns="http://www.w3.org/2000/svg" aria-label="خدمة كهربائي سيارات متنقل">
        <rect width="600" height="360" fill="#111820"/>
        <circle cx="480" cy="75" r="55" fill="#ffe58a" opacity=".75"/>
        <path d="M70 265 Q90 205 155 185 L370 185 Q425 190 465 235 L505 265 Z" fill="#d6d9dc"/>
        <rect x="175" y="195" width="95" height="50" rx="7" fill="#30485a"/>
        <rect x="285" y="195" width="95" height="50" rx="7" fill="#30485a"/>
        <circle cx="155" cy="270" r="31" fill="#0b0d10"/><circle cx="155" cy="270" r="12" fill="#8c969f"/>
        <circle cx="420" cy="270" r="31" fill="#0b0d10"/><circle cx="420" cy="270" r="12" fill="#8c969f"/>
        <path d="M95 315 H520" stroke="#505861" stroke-width="6"/>
        <path d="M525 115 L500 145 L525 145 L495 180" fill="none" stroke="#ffd34d" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
      </svg><span>خدمة متنقلة</span>
    </div>
  </div>
</section>

  <div class="location">
    <h2>📍 موقع المركز</h2>
    <p>ماركا الشمالية — بالقرب من دوار زمزم</p>
    <p>يفضل الاتصال قبل الحضور للتأكد من توفر الخدمة.</p>
    <a class="btn call" href="tel:0781735039">احجز موعد</a>
  </div>
</main>

<footer>© 2026 المركز الهندي | كهربائي سيارات متنقل</footer>
</body>
</html>
